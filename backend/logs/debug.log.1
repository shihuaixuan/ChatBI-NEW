ta_type": "int",\n    "is_time": false,\n    "name": "未销售天数",\n    "semantic_type": null,\n    "value_kind": "numeric_id"\n  },\n  {\n    "aliases": [],\n    "data_type": "varchar",\n    "is_time": false,\n    "name": "交易渠道，如线上或线下",\n    "semantic_type": null,\n    "value_kind": "string_label"\n  },\n  {\n    "aliases": [],\n    "data_type": "int",\n    "is_time": false,\n    "name": "欠款账龄天数",\n    "semantic_type": null,\n    "value_kind": "numeric_id"\n  }\n]\n```\n\n# 时间字段候选\n\n```json\n[\n  {\n    "aliases": [],\n    "data_type": "date",\n    "is_time": true,\n    "name": "统计日期",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "datetime",\n    "is_time": true,\n    "name": "记录创建时间",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "datetime",\n    "is_time": true,\n    "name": "记录更新时间",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "date",\n    "is_time": true,\n    "name": "快照日期",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "datetime",\n    "is_time": true,\n    "name": "进入待发货状态时间",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "datetime",\n    "is_time": true,\n    "name": "应发截止时间",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "date",\n    "is_time": true,\n    "name": "库存快照日期",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "datetime",\n    "is_time": true,\n    "name": "最后销售时间",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "date",\n    "is_time": true,\n    "name": "交易统计日期",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "datetime",\n    "is