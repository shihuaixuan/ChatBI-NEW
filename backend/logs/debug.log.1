,\n    "is_time": true,\n    "name": "快照日期",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "varchar",\n    "is_time": false,\n    "name": "未发订单号",\n    "semantic_type": null,\n    "value_kind": "string_label"\n  },\n  {\n    "aliases": [\n      "客户"\n    ],\n    "data_type": "varchar",\n    "is_time": false,\n    "name": "客户ID",\n    "semantic_type": null,\n    "value_kind": "numeric_id"\n  },\n  {\n    "aliases": [\n      "客户"\n    ],\n    "data_type": "varchar",\n    "is_time": false,\n    "name": "客户名称",\n    "semantic_type": null,\n    "value_kind": "string_label"\n  },\n  {\n    "aliases": [],\n    "data_type": "datetime",\n    "is_time": true,\n    "name": "进入待发货状态时间",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "datetime",\n    "is_time": true,\n    "name": "应发截止时间",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "int",\n    "is_time": false,\n    "name": "超时天数",\n    "semantic_type": null,\n    "value_kind": "numeric_id"\n  },\n  {\n    "aliases": [],\n    "data_type": "tinyint",\n    "is_time": false,\n    "name": "是否超时",\n    "semantic_type": null,\n    "value_kind": "numeric_id"\n  },\n  {\n    "aliases": [],\n    "data_type": "text",\n    "is_time": false,\n    "name": "商品摘要，仅用于展示",\n    "semantic_type": null,\n    "value_kind": "string_label"\n  },\n  {\n    "aliases": [],\n    "data_type": "date",\n    "is_time": true,\n    "name": "库存快照日期",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [\n      "商品"\n    ],\n    "data_type": "varchar",\n    "is_time": false,\n    "name": "商品ID",\n    "semantic_type": null,\n    "value_kind": "numeric_id"\n  },\n  {\n    "aliases": [],\n    "data_type": "varchar",\n    "is_time": false,\n    "name": "货号",\n    "semantic_type": null,\n    "value_kind": "string_label"\n  },\n  {\n    "aliases": [\n      "商品"\n    ],\n    "data_type": "varchar",\n    "is_time": false,\n    "name": "商品名称",\n    "semantic_type": null,\n    "value_kind": "string_label"\n  },\n  {\n    "aliases": [],\n    "data_type": "datetime",\n    "is_time": true,\n    "name": "最后销售时间",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "int",\n    "is_time": false,\n    "name": "未销售天数",\n    "semantic_type": null,\n    "value_kind": "numeric_id"\n  },\n  {\n    "aliases": [],\n    "data_type": "date",\n    "is_time": true,\n    "name": "交易统计日期",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "varchar",\n    "is_time": false,\n    "name": "交易渠道，如线上或线下",\n    "semantic_type": null,\n    "value_kind": "string_label"\n  },\n  {\n    "aliases": [],\n    "data_type": "datetime",\n    "is_time": true,\n    "name": "最近下单时间",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "date",\n    "is_time": true,\n    "name": "欠款快照日期",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "date",\n    "is_time": true,\n    "name": "最早未结清欠款日期",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "date",\n    "is_time": true,\n    "name": "最近欠款发生日期",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "int",\n    "is_time": false,\n    "name": "欠款账龄天数",\n    "semantic_type": null,\n    "value_kind": "numeric_id"\n  }\n]\n```\n\n# 会话上下文\n\n```json\n{\n  "question": "当前库存量最低的 10 个商品是哪些？"\n}\n```\n\n# 用户反馈\n\n```json\n{}\n```\n\n# 任务\n\n请抽取指标线索和时间线索，并严格按指定 JSON 结构输出。', 'role': 'user'}], 'model': 'deepseek-v4-flash', 'stream': False}}
