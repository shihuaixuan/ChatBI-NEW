{"time": "2026-06-23 11:18:59,553", "name": "openai._base_client", "level": "DEBUG", "line": 1074, "message": "HTTP Response: POST https://api.deepseek.com/chat/completions \"200 OK\" Headers({'server': 'openresty', 'content-type': 'application/json', 'vary': 'origin, access-control-request-method, access-control-request-headers', 'access-control-allow-credentials': 'true', 'x-ds-trace-id': 'adc089cc1522f68785e843ccb15424a3', 'strict-transport-security': 'max-age=31536000; includeSubDomains; preload', 'x-content-type-options': 'nosniff', 'age': '0', 'transfer-encoding': 'chunked', 'connection': 'keep-alive', 'date': 'Tue, 23 Jun 2026 03:18:57 GMT', 'eo-log-uuid': '7864248328068736171', 'eo-cache-status': 'MISS'})"}
