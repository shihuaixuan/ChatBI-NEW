0天未动销的商品有多少个？\n\n# 可用维度\n\n```json\n[\n  {\n    "aliases": [\n      "商家"\n    ],\n    "data_type": "bigint",\n    "is_time": false,\n    "name": "商家ID",\n    "semantic_type": null,\n    "value_kind": "numeric_id"\n  },\n  {\n    "aliases": [\n      "档口"\n    ],\n    "data_type": "bigint",\n    "is_time": false,\n    "name": "档口ID",\n    "semantic_type": null,\n    "value_kind": "numeric_id"\n  },\n  {\n    "aliases": [],\n    "data_type": "varchar",\n    "is_time": false,\n    "name": "未发订单号",\n    "semantic_type": null,\n    "value_kind": "string_label"\n  },\n  {\n    "aliases": [\n      "客户"\n    ],\n    "data_type": "varchar",\n    "is_time": false,\n    "name": "客户ID",\n    "semantic_type": null,\n    "value_kind": "numeric_id"\n  },\n  {\n    "aliases": [\n      "客户"\n    ],\n    "data_type": "varchar",\n    "is_time": false,\n    "name": "客户名称",\n    "semantic_type": null,\n    "value_kind": "string_label"\n  },\n  {\n    "aliases": [],\n    "data_type": "int",\n    "is_time": false,\n    "name": "超时天数",\n    "semantic_type": null,\n    "value_kind": "numeric_id"\n  },\n  {\n    "aliases": [],\n    "data_type": "tinyint",\n    "is_time": false,\n    "name": "是否超时",\n    "semantic_type": null,\n    "value_kind": "numeric_id"\n  },\n  {\n    "aliases": [],\n    "data_type": "text",\n    "is_time": false,\n    "name": "商品摘要，仅用于展示",\n    "semantic_type": null,\n    "value_kind": "string_label"\n  },\n  {\n    "aliases": [\n      "商品"\n    ],\n    "data_type": "varchar",\n    "is_time": false,\n    "name": "商品ID",\n    "semantic_type": null,\n    "value_kind": "numeric_id"\n  },\n  {\n    "aliases": [],\n    "data_type": "varchar",\n    "is_time": false,\n    "name": "货号",\n    "semantic_type": null,\n    "value_kind": "string_label"\n  },\n  {\n    "aliases": [\n      "商品"\n    ],\n    "data_type": "varchar",\n    "is_time": false,\n    "name": "商品名称",\n    "semantic_type": null,\n    "value_kind": "string_label"\n  },\n  {\n    "aliases": [],\n    "data_type": "