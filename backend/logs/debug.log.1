 'function', 'function': {'name': 'query_semantic_data', 'description': '执行受治理的语义数据查询。', 'parameters': {'$defs': {'EvidenceSelector': {'additionalProperties': False, 'properties': {'evidence_id': {'maxLength': 256, 'minLength': 1, 'title': 'Evidence Id', 'type': 'string'}, 'column_ref': {'minLength': 1, 'title': 'Column Ref', 'type': 'string'}, 'selection': {'enum': ['all', 'top', 'bottom'], 'title': 'Selection', 'type': 'string'}}, 'required': ['evidence_id', 'column_ref', 'selection'], 'title': 'EvidenceSelector', 'type': 'object'}, 'QueryComparison': {'additionalProperties': False, 'properties': {'base_period': {'maxLength': 64, 'minLength': 1, 'title': 'Base Period', 'type': 'string'}, 'against_period': {'maxLength': 64, 'minLength': 1, 'title': 'Against Period', 'type': 'string'}, 'outputs': {'items': {'enum': ['current', 'previous', 'difference', 'growth_rate'], 'type': 'string'}, 'minItems': 1, 'title': 'Outputs', 'type': 'array'}}, 'required': ['base_period', 'against_period', 'outputs'], 'title': 'QueryComparison', 'type': 'object'}, 'QueryFilter': {'additionalProperties': False, 'properties': {'field_ref': {'minLength': 1, 'title': 'Field Ref', 'type': 'string'}, 'operator': {'maxLength': 32, 'minLength': 1, 'title': 'Operator', 'type': 'string'}, 'value': {'anyOf': [{'type': 'string'}, {'type': 'integer'}, {'type': 'number'}, {'type': 'boolean'}, {'type': 'null'}], 'default': None, 'title': 'Value'}, 'evidence_selector': {'anyOf': [{'$ref': '#/$defs/EvidenceSelector'}, {'type': 'null'}], 'default': None}}, 'required': ['field_ref', 'operator'], 'title': 'QueryFilter', 'type': 'object'}, 'QueryOrder': {'additionalProperties': False, 'properties': {'field_ref': {'minLength': 1, 'title': 'Field Ref', 'type': 'string'}, 'value_role': {'maxLength': 64, 'minLength': 1, 'title': 'Value Role', 'type': 'string'}, 'direction': {'enum': ['asc', 'desc'], 'title': 'Direction', 'type': 'string'}}, 'required': ['field_ref', 'value_role', 'direction'], 'title': 'QueryOrd