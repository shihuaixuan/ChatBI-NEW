   "semantic_type": null,\n    "value_kind": "numeric_id"\n  },\n  {\n    "aliases": [],\n    "data_type": "date",\n    "is_time": true,\n    "name": "时间",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [\n      "商家"\n    ],\n    "data_type": "bigint",\n    "is_time": false,\n    "name": "商家ID",\n    "semantic_type": null,\n    "value_kind": "numeric_id"\n  },\n  {\n    "aliases": [\n      "店铺"\n    ],\n    "data_type": "bigint",\n    "is_time": false,\n    "name": "店铺ID",\n    "semantic_type": null,\n    "value_kind": "numeric_id"\n  }\n]\n```\n\n# 会话上下文\n\n```json\n{\n  "question": "今天店铺的客户人数"\n}\n```\n\n# 用户反馈\n\n```json\n{}\n```\n\n# 任务\n\n请识别维度、维度角色和维度值，并严格按指定 JSON 结构输出。', 'role': 'user'}], 'model': 'deepseek-v4-flash', 'stream': False}}
