ion": "is_negative_stock", "display_name": "是否负库存", "matched_phrases": [], "model_id": 248, "ref": "METRIC:284:248", "score": 0.016129032258064516}, {"asset_id": 280, "asset_type": "METRIC", "biz_name": "stock_qty", "description": "当前库存件数", "display_name": "当前库存件数", "matched_phrases": [], "model_id": 248, "ref": "METRIC:280:248", "score": 0.015873015873015872}, {"asset_id": 291, "asset_type": "METRIC", "biz_name": "arrears_amt", "description": "当前欠款余额", "display_name": "当前欠款余额", "matched_phrases": [], "model_id": 250, "ref": "METRIC:291:250", "score": 0.015625}]}, "rewrite_question": "2026年6月29日总GMV比6月28日下降了，请找出下降最大的商家，然后继续下钻分析该商家下各档口的下降情况。"}', 'role': 'user'}], 'model': 'deepseek-v4-flash', 'reasoning_effort': 'none', 'response_format': {'type': 'json_object'}, 'stream': False, 'temperature': 0}}
