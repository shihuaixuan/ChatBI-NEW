  {\\n    \"aliases\": [],\\n    \"data_type\": \"datetime\",\\n    \"is_time\": true,\\n    \"name\": \"记录更新时间\",\\n    \"semantic_type\": \"time\",\\n    \"value_kind\": \"date\"\\n  },\\n  {\\n    \"aliases\": [],\\n    \"data_type\": \"date\",\\n    \"is_time\": true,\\n    \"name\": \"快照日期\",\\n    \"semantic_type\": \"time\",\\n    \"value_kind\": \"date\"\\n  },\\n  {\\n    \"aliases\": [],\\n    \"data_type\": \"varchar\",\\n    \"is_time\": false,\\n    \"name\": \"未发订单号\",\\n    \"semantic_type\": null,\\n    \"value_kind\": \"string_label\"\\n  },\\n  {\\n    \"aliases\": [\\n      \"客户\"\\n    ],\\n    \"data_type\": \"varchar\",\\n    \"is_time\": false,\\n    \"name\": \"客户ID\",\\n    \"semantic_type\": null,\\n    \"value_kind\": \"numeric_id\"\\n  },\\n  {\\n    \"aliases\": [\\n      \"客户\"\\n    ],\\n    \"data_type\": \"varchar\",\\n    \"is_time\": false,\\n    \"name\": \"客户名称\",\\n    \"semantic_type\": null,\\n    \"value_kind\": \"string_label\"\\n  },\\n  {\\n    \"aliases\": [],\\n    \"data_type\": \"datetime\",\\n    \"is_time\": true,\\n    \"name\": \"进入待发货状态时间\",\\n    \"semantic_type\": \"time\",\\n    \"value_kind\": \"date\"\\n  },\\n  {\\n    \"aliases\": [],\\n    \"data_type\": \"datetime\",\\n    \"is_time\": true,\\n    \"name\": \"应发截止时间\",\\n    \"semantic_type\": \"time\",\\n    \"value_kind\": \"date\"\\n  },\\n  {\\n    \"aliases\": [],\\n    \"data_type\": \"int\",\\n    \"is_time\": false,\\n    \"name\": \"超时天数\",\\n    \"semantic_type\": null,\\n    \"value_kind\": \"numeric_id\"\\n  },\\n  {\\n    \"aliases\": [],\\n    \"data_type\": \"tinyint\",\\n    \"is_time\": false,\\n    \"name\": \"是否超时\",\\n    \"semantic_type\": null,\\n    \"value_kind\": \"numeric_id\"\\n  },\\n  {\\n    \"aliases\": [],\\n    \"data_type\": \"text\",\\n    \"is_time\": false,\\n    \"name\": \"商品摘要，仅用于展示\",\\n    \"semantic_type\": null,\\n    \"value_kind\": \"string_label\"\\n  },\\n  {\\n    \"aliases\": [],\\n    \"data_type\": \"dat