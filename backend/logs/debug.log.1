}, 'required': ['metrics', 'time_ranges', 'purpose'], 'title': 'QuerySemanticDataArgs', 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'inspect_evidence', 'description': '验证证据所有权后从 ResultStore 读取完整结果，按逻辑列、排序、范围和采样预算投影。只读、幂等；返回逻辑列与统计，不返回其他 Run 的数据，也不会把大结果整表带进对话。', 'parameters': {'$defs': {'ResearchOrder': {'additionalProperties': False, 'properties': {'ref': {'minLength': 1, 'title': 'Ref', 'type': 'string'}, 'direction': {'$ref': '#/$defs/ResearchOrderDirection', 'default': 'desc'}, 'value_role': {'default': 'value', 'enum': ['value', 'current', 'previous', 'difference', 'growth_rate', 'share', 'contribution'], 'title': 'Value Role', 'type': 'string'}}, 'required': ['ref'], 'title': 'ResearchOrder', 'type': 'object'}, 'ResearchOrderDirection': {'enum': ['asc', 'desc'], 'title': 'ResearchOrderDirection', 'type': 'string'}}, 'additionalProperties': False, 'description': 'inspect_evidence 参数：只读投影，不携带 run_id。', 'properties': {'evidence_id': {'maxLength': 128, 'minLength': 1, 'title': 'Evidence Id', 'type': 'string'}, 'logical_column_refs': {'default': [], 'items': {'type': 'string'}, 'title': 'Logical Column Refs', 'type': 'array'}, 'order': {'default': [], 'items': {'$ref': '#/$defs/ResearchOrder'}, 'title': 'Order', 'type': 'array'}, 'offset': {'default': 0, 'maximum': 100000, 'minimum': 0, 'title': 'Offset', 'type': 'integer'}, 'limit': {'anyOf': [{'exclusiveMinimum': 0, 'maximum': 1000, 'type': 'integer'}, {'type': 'null'}], 'default': None, 'title': 'Limit'}, 'max_rows': {'default': 20, 'exclusiveMinimum': 0, 'maximum': 100, 'title': 'Max Rows', 'type': 'integer'}, 'max_chars': {'default': 12000, 'exclusiveMinimum': 0, 'maximum': 100000, 'title': 'Max Chars', 'type': 'integer'}}, 'required': ['evidence_id'], 'title': 'InspectEvidenceArgs', 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'compute_evidence', 'description': '只接受当前 Run 的证据引用和白名单确定性操作：difference、growth_rate、share、ratio、ranking、topn_other、merge、contribution、reconciliation。输