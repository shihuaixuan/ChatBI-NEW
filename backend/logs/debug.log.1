': {'$defs': {'ResearchClaim': {'additionalProperties': False, 'properties': {'statement': {'maxLength': 2000, 'minLength': 1, 'title': 'Statement', 'type': 'string'}, 'evidence_ids': {'items': {'type': 'string'}, 'minItems': 1, 'title': 'Evidence Ids', 'type': 'array'}, 'claim_level': {'$ref': '#/$defs/ResearchClaimLevel', 'default': 'correlation_clue'}, 'confidence': {'default': 'medium', 'enum': ['high', 'medium', 'low'], 'title': 'Confidence', 'type': 'string'}}, 'required': ['statement', 'evidence_ids'], 'title': 'ResearchClaim', 'type': 'object'}, 'ResearchClaimLevel': {'enum': ['contribution', 'common_change', 'correlation_clue', 'limitation'], 'title': 'ResearchClaimLevel', 'type': 'string'}, 'ResearchCompletionReason': {'enum': ['sufficient_evidence', 'premise_not_supported', 'no_new_direction', 'data_insufficient', 'needs_clarification', 'execution_failed', 'partial_failure', 'budget_exhausted', 'cancelled'], 'title': 'ResearchCompletionReason', 'type': 'string'}, 'ResearchHypothesisAssessment': {'additionalProperties': False, 'description': 'finish_research 返回的最小假设评估，不判断结论强度。', 'properties': {'hypothesis_id': {'maxLength': 128, 'minLength': 1, 'title': 'Hypothesis Id', 'type': 'string'}, 'assessment': {'enum': ['supported', 'weakened', 'inconclusive', 'invalid'], 'title': 'Assessment', 'type': 'string'}, 'evidence_ids': {'default': [], 'items': {'type': 'string'}, 'title': 'Evidence Ids', 'type': 'array'}, 'reason': {'maxLength': 2000, 'minLength': 1, 'title': 'Reason', 'type': 'string'}}, 'required': ['hypothesis_id', 'assessment', 'reason'], 'title': 'ResearchHypothesisAssessment', 'type': 'object'}, 'ResearchReportFinding': {'additionalProperties': False, 'description': '报告草案中的一条数据结论；数字必须能溯源到引用证据（§10.3.3）。', 'properties': {'statement': {'maxLength': 2000, 'minLength': 1, 'title': 'Statement', 'type': 'string'}, 'evidence_ids': {'items': {'type': 'string'}, 'minItems': 1, 'title': 'Evidence Ids', 'type': 'array'}, 'confidence': {'default': 'medium', 'en