ype': 'object'}, 'QueryFilter': {'additionalProperties': False, 'properties': {'field_ref': {'minLength': 1, 'title': 'Field Ref', 'type': 'string'}, 'operator': {'maxLength': 32, 'minLength': 1, 'title': 'Operator', 'type': 'string'}, 'value': {'anyOf': [{'type': 'string'}, {'type': 'integer'}, {'type': 'number'}, {'type': 'boolean'}, {'type': 'null'}], 'default': None, 'title': 'Value'}, 'evidence_selector': {'anyOf': [{'$ref': '#/$defs/EvidenceSelector'}, {'type': 'null'}], 'default': None}}, 'required': ['field_ref', 'operator'], 'title': 'QueryFilter', 'type': 'object'}, 'QueryOrder': {'additionalProperties': False, 'properties': {'field_ref': {'minLength': 1, 'title': 'Field Ref', 'type': 'string'}, 'value_role': {'maxLength': 64, 'minLength': 1, 'title': 'Value Role', 'type': 'string'}, 'direction': {'enum': ['asc', 'desc'], 'title': 'Direction', 'type': 'string'}}, 'required': ['field_ref', 'value_role', 'direction'], 'title': 'QueryOrder', 'type': 'object'}, 'QueryPeriod': {'additionalProperties': False, 'properties': {'role': {'maxLength': 64, 'minLength': 1, 'title': 'Role', 'type': 'string'}, 'start': {'maxLength': 64, 'minLength': 1, 'title': 'Start', 'type': 'string'}, 'end': {'maxLength': 64, 'minLength': 1, 'title': 'End', 'type': 'string'}}, 'required': ['role', 'start', 'end'], 'title': 'QueryPeriod', 'type': 'object'}, 'QueryResultSpec': {'additionalProperties': False, 'properties': {'order_by': {'default': [], 'items': {'$ref': '#/$defs/QueryOrder'}, 'title': 'Order By', 'type': 'array'}, 'limit': {'exclusiveMinimum': 0, 'maximum': 10000, 'title': 'Limit', 'type': 'integer'}}, 'required': ['limit'], 'title': 'QueryResultSpec', 'type': 'object'}, 'QueryTimeSpec': {'additionalProperties': False, 'properties': {'dimension_ref': {'minLength': 1, 'title': 'Dimension Ref', 'type': 'string'}, 'grain': {'enum': ['day', 'week', 'month', 'quarter', 'year'], 'title': 'Grain', 'type': 'string'}, 'periods': {'items': {'$ref': '#/$defs/QueryPeriod'}, 'minItems