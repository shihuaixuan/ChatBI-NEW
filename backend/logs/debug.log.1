dimension_refs\": [],\\n      \"column_dimension_ref\": null\\n    }\\n  ],\\n  \"result_contract\": {\\n    \"primary_requirement_id\": \"主要叶子结果ID\",\\n    \"supporting_requirement_ids\": [],\\n    \"ordered_requirement_ids\": [\"主要叶子结果ID\"],\\n    \"completion_policy\": \"require_primary\",\\n    \"analysis_type\": \"limited_multistep\"\\n  }\\n}\\n\\n例如 query_current、query_previous -> calc_difference -> calc_top3 时，唯一叶子是\\ncalc_top3。result_contract 只能声明 calc_top3，不能把 query_current、query_previous\\n或 calc_difference 声明为 supporting。', 'role': 'system'}, {'content': '请根据以下受限上下文生成 ExecutionRequirementDraft：\\n{\"allowed_operations\": [\"merge\", \"difference\", \"growth_rate\", \"share\", \"ratio\", \"topn_other\", \"pivot\", \"contribution\"], \"available_dimensions\": [{\"biz_name\": \"stall_id\", \"display_name\": \"档口ID\", \"model_ref\": \"MODEL:246\", \"ref\": \"DIMENSION:278:246\"}], \"available_metrics\": [{\"additivity\": \"FULL\", \"biz_name\": \"gmv_total\", \"display_name\": \"总GMV\", \"model_ref\": \"MODEL:246\", \"ref\": \"METRIC:271:246\"}], \"budget\": {\"max_calculation_count\": 6, \"max_dag_depth\": 4, \"max_query_count\": 6, \"max_total_nodes\": 10}, \"objective\": \"计算2026年6月30日和2026年6月29日各档口总GMV差值，再输出差值最大的3个档口，其余汇总为其他\", \"requested_outputs\": [\"差值最大的3个档口\", \"其余档口汇总为其他\"], \"time_roles\": [\"current\", \"previous\"]}', 'role': 'user'}], 'model': 'deepseek-v4-flash', 'reasoning_effort': 'none', 'response_format': {'type': 'json_object'}, 'stream': False, 'temperature': 0}}"}
