{"time": "2026-06-22 18:01:04,576", "name": "openai._base_client", "level": "DEBUG", "line": 1074, "message": "HTTP Response: POST https://api.deepseek.com/chat/completions \"200 OK\" Headers({'server': 'openresty', 'content-type': 'application/json', 'vary': 'origin, access-control-request-method, access-control-request-headers', 'access-control-allow-credentials': 'true', 'x-ds-trace-id': '3600f7035019120c4a8d6bda536dc09e', 'strict-transport-security': 'max-age=31536000; includeSubDomains; preload', 'x-content-type-options': 'nosniff', 'age': '0', 'transfer-encoding': 'chunked', 'connection': 'keep-alive', 'date': 'Mon, 22 Jun 2026 10:01:02 GMT', 'eo-log-uuid': '6831728906390160026', 'eo-cache-status': 'MISS'})"}
