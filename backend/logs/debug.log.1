 'title': 'ResearchHypothesisAssessment', 'type': 'object'}, 'ResearchReportFinding': {'additionalProperties': False, 'description': '报告草案中的一条数据结论；数字必须能溯源到引用证据（§10.3.3）。', 'properties': {'statement': {'maxLength': 2000, 'minLength': 1, 'title': 'Statement', 'type': 'string'}, 'evidence_ids': {'items': {'type': 'string'}, 'minItems': 1, 'title': 'Evidence Ids', 'type': 'array'}, 'confidence': {'default': 'medium', 'enum': ['high', 'medium', 'low'], 'title': 'Confidence', 'type': 'string'}, 'statement_kind': {'default': 'correlational', 'enum': ['causal', 'correlational'], 'title': 'Statement Kind', 'type': 'string'}, 'limitations': {'default': [], 'items': {'type': 'string'}, 'title': 'Limitations', 'type': 'array'}}, 'required': ['statement', 'evidence_ids'], 'title': 'ResearchReportFinding', 'type': 'object'}}, 'additionalProperties': False, 'description': 'finish_research 参数：结论必须引用当前 Run 的证据。', 'properties': {'reason': {'$ref': '#/$defs/ResearchCompletionReason'}, 'summary': {'maxLength': 4000, 'minLength': 1, 'title': 'Summary', 'type': 'string'}, 'claims': {'default': [], 'items': {'$ref': '#/$defs/ResearchClaim'}, 'title': 'Claims', 'type': 'array'}, 'findings': {'default': [], 'items': {'$ref': '#/$defs/ResearchReportFinding'}, 'title': 'Findings', 'type': 'array'}, 'evidence_ids': {'default': [], 'items': {'type': 'string'}, 'title': 'Evidence Ids', 'type': 'array'}, 'hypothesis_assessments': {'default': [], 'items': {'$ref': '#/$defs/ResearchHypothesisAssessment'}, 'title': 'Hypothesis Assessments', 'type': 'array'}, 'limitations': {'default': [], 'items': {'type': 'string'}, 'title': 'Limitations', 'type': 'array'}, 'unanswered_questions': {'default': [], 'items': {'type': 'string'}, 'title': 'Unanswered Questions', 'type': 'array'}}, 'required': ['reason', 'summary'], 'title': 'FinishResearchArgs', 'type': 'object'}}}]}}"}
