    - DIMENSION:278:246\\\\n    - DIMENSION:306:249\\\\n    - DIMENSION:305:249\\\\n    - DIMENSION:276:246\\\\n    - DIMENSION:304:249\\\\n  - ref: METRIC:286:249\\\\n    name: 客户当日GMV\\\\n    description: 客户当日GMV：基于字段 customer_gmv 按模型粒度汇总。\\\\n    aggregation: SUM\\\\n    unit: null\\\\n    dimensions:\\\\n    - DIMENSION:277:246\\\\n    - DIMENSION:278:246\\\\n    - DIMENSION:306:249\\\\n    - DIMENSION:305:249\\\\n    - DIMENSION:276:246\\\\n    - DIMENSION:304:249\\\\n  - ref: METRIC:313:249\\\\n    name: 新增成交客户数\\\\n    description: 新增成交客户数：按模型粒度计算，表达式为 COUNT(DISTINCT CASE WHEN is_first_deal = 1 THEN customer_id END)。\\\\n    aggregation: SUM\\\\n    unit: null\\\\n    dimensions:\\\\n    - DIMENSION:277:246\\\\n    - DIMENSION:278:246\\\\n    - DIMENSION:306:249\\\\n    - DIMENSION:305:249\\\\n    - DIMENSION:276:246\\\\n    - DIMENSION:304:249\\\\n  dimensions:\\\\n  - ref: DIMENSION:277:246\\\\n    name: 商家ID\\\\n    description: \\'\\'\\\\n    grains: []\\\\n  - ref: DIMENSION:278:246\\\\n    name: 档口ID\\\\n    description: \\'\\'\\\\n    grains: []\\\\n  - ref: DIMENSION:306:249\\\\n    name: 档口ID\\\\n    description: \\'\\'\\\\n    grains: []\\\\n  - ref: DIMENSION:305:249\\\\n    name: 商家ID\\\\n    description: \\'\\'\\\\n    grains: []\\\\n  - ref: DIMENSION:276:246\\\\n    name: 统计日期\\\\n    description: \\'\\'\\\\n    grains: []\\\\n  - ref: DIMENSION:304:249\\\\n    name: 交易统计日期\\\\n    description: \\'\\'\\\\n    grains: []\\\\n  hierarchies: []\\\\n  metric_formulas: []\\\\n  metric_analysis_relations: []\\\\n  ambiguities: []\\\\n\"},\"evidence\":[],\"findings\":[],\"todo_items\":[],\"attempted_actions\":[{\"attempt_id\":\"attempt:call_00_loY2dj6RRo0QDcCl8kSs7143\",\"action_type\":\"query_semantic_data\",\"purpose\":\"执行 query_semantic_data\",\"parameter_summary\":\"{\\\\\"comparison\\\\\":{\\\\\"against_period\\\\\":\\\\\"2026-06-28\\\\\",\\\\\"base_period\\\\\":\\\\\"2026-06-29\\\\\",\\\\\"outputs\\\\\":[\\\\\"current\\\\\",\\\\\"previous\\\\\"