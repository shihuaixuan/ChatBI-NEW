\n    "data_type": "varchar",\n    "is_time": false,\n    "name": "商品名称",\n    "semantic_type": null,\n    "value_kind": "string_label"\n  },\n  {\n    "aliases": [],\n    "data_type": "datetime",\n    "is_time": true,\n    "name": "最后销售时间",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "int",\n    "is_time": false,\n    "name": "未销售天数",\n    "semantic_type": null,\n    "value_kind": "numeric_id"\n  },\n  {\n    "aliases": [],\n    "data_type": "date",\n    "is_time": true,\n    "name": "交易统计日期",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "varchar",\n    "is_time": false,\n    "name": "交易渠道，如线上或线下",\n    "semantic_type": null,\n    "value_kind": "string_label"\n  },\n  {\n    "aliases": [],\n    "data_type": "datetime",\n    "is_time": true,\n    "name": "最近下单时间",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "date",\n    "is_time": true,\n    "name": "欠款快照日期",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "date",\n    "is_time": true,\n    "name": "最早未结清欠款日期",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "date",\n    "is_time": true,\n    "name": "最近欠款发生日期",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "int",\n    "is_time": false,\n    "name": "欠款账龄天数",\n    "semantic_type": null,\n    "value_kind": "numeric_id"\n  }\n]\n```\n\n# 会话上下文\n\n```json\n{\n  "question": "当前超时未发订单有多少笔？"\n}\n```\n\n# 用户反馈\n\n```json\n{}\n```\n\n# 任务\n\n请抽取指标线索和时间线索，并严格按指定 JSON 结构输出。', 'role': 'user'}], 'model': 'deepseek-v4-flash', 'stream': False}}
