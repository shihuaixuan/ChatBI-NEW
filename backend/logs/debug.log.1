rue,\n    "name": "最近下单时间",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "date",\n    "is_time": true,\n    "name": "欠款快照日期",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "date",\n    "is_time": true,\n    "name": "最早未结清欠款日期",\n    "semantic_type": "time",\n    "value_kind": "date"\n  },\n  {\n    "aliases": [],\n    "data_type": "date",\n    "is_time": true,\n    "name": "最近欠款发生日期",\n    "semantic_type": "time",\n    "value_kind": "date"\n  }\n]\n```\n\n# 会话上下文\n\n```json\n{\n  "question": "超时天数最长的 10 笔订单是哪些？"\n}\n```\n\n# 用户反馈\n\n```json\n{}\n```\n\n# 任务\n\n请识别维度、维度角色和维度值，并严格按指定 JSON 结构输出。', 'role': 'user'}], 'model': 'deepseek-v4-flash', 'stream': False}}
