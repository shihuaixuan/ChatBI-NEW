ompare\", \"growth\", \"share\", \"topn_other\", \"pivot\", \"expr\"], \"title\": \"ComputeOperation\", \"type\": \"string\"}, \"ComputeTask\": {\"additionalProperties\": false, \"properties\": {\"derive\": {\"default\": [], \"items\": {\"$ref\": \"#/$defs/ComputeDerivation\"}, \"title\": \"Derive\", \"type\": \"array\"}, \"id\": {\"maxLength\": 128, \"minLength\": 1, \"title\": \"Id\", \"type\": \"string\"}, \"inputs\": {\"items\": {\"type\": \"string\"}, \"minItems\": 1, \"title\": \"Inputs\", \"type\": \"array\"}, \"join_on\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Join On\", \"type\": \"array\"}, \"operation\": {\"$ref\": \"#/$defs/ComputeOperation\"}, \"options\": {\"additionalProperties\": true, \"title\": \"Options\", \"type\": \"object\"}, \"type\": {\"const\": \"compute\", \"default\": \"compute\", \"title\": \"Type\", \"type\": \"string\"}}, \"required\": [\"id\", \"operation\", \"inputs\"], \"title\": \"ComputeTask\", \"type\": \"object\"}, \"PlanEdge\": {\"additionalProperties\": false, \"properties\": {\"source\": {\"maxLength\": 128, \"minLength\": 1, \"title\": \"Source\", \"type\": \"string\"}, \"target\": {\"maxLength\": 128, \"minLength\": 1, \"title\": \"Target\", \"type\": \"string\"}}, \"required\": [\"source\", \"target\"], \"title\": \"PlanEdge\", \"type\": \"object\"}, \"PlanValidation\": {\"additionalProperties\": false, \"properties\": {\"reason_codes\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Reason Codes\", \"type\": \"array\"}, \"reports\": {\"default\": [], \"items\": {\"additionalProperties\": true, \"type\": \"object\"}, \"title\": \"Reports\", \"type\": \"array\"}, \"status\": {\"$ref\": \"#/$defs/AnalysisPlanStatus\", \"default\": \"DRAFT\"}}, \"title\": \"PlanValidation\", \"type\": \"object\"}, \"PresentationHint\": {\"additionalProperties\": false, \"properties\": {\"chart_hint\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Chart Hint\"}, \"primary_result\": {\"maxLength\": 128, \"minLength\": 1, \"title\": \"Primary Result\", \"type\": \"string\"}}, \"required\": [\"primary_result\"], \"title\": \"PresentationHint\", \"type\": \"object\"}, \"QueryTask\": {\"additionalProperties\": false, \"properties\": {\"compiled\": {\"anyOf\": [{\"$ref\": \"#/$defs/CompiledQuery\"}, {\"type\": \"null\"}], \"default\": null}, \"id\": {\"maxLength\": 128, \"minLength\": 1, \"title\": \"Id\", \"type\": \"string\"}, \"spec\": {\"$ref\": \"#/$defs/QueryTaskSpec\"}, \"type\": {\"const\": \"query\", \"default\": \"query\", \"title\": \"Type\", \"type\": \"string\"}}, \"required\": [\"id\", \"spec\"], \"title\": \"QueryTask\", \"type\": \"object\"}, \"QueryTaskSpec\": {\"additionalProperties\": false, \"description\": \"规划器输出的语义查询草案；编译与证明结果不混入该对象。\", \"properties\": {\"dataset_id\": {\"exclusiveMinimum\": 0, \"title\": \"Dataset Id\", \"type\": \"integer\"}, \"dimension_ids\": {\"default\": [], \"items\": {\"type\": \"integer\"}, \"title\": \"Dimension Ids\", \"type\": \"array\"}, \"filters\": {\"default\": [], \"items\": {\"additionalProperties\": true, \"type\": \"object\"}, \"title\": \"Filters\", \"type\": \"array\"}, \"having\": {\"default\": [], \"items\": {\"additionalProperties\": true, \"type\": \"object\"}, \"title\": \"Having\", \"type\": \"array\"}, \"limit\": {\"anyOf\": [{\"exclusiveMinimum\": 0, \"type\": \"integer\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Limit\"}, \"metric_ids\": {\"default\": [], \"items\": {\"type\": \"integer\"}, \"title\": \"Metric Ids\", \"type\": \"array\"}, \"order_by\": {\"default\": [], \"items\": {\"additionalProperties\": true, \"type\": \"object\"}, \"title\": \"Order By\", \"type\": \"array\"}, \"query_shape\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Query Shape\"}, \"select_mode\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Select Mode\"}, \"time_di