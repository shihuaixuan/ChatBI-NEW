户数),\n(created_at:datetime, 记录创建时间),\n(updated_at:datetime, 记录更新时间)\n]\n# Table: snap_customer_arrears, 客户欠款快照表\n[\n(snapshot_date:date, 欠款快照日期),\n(seller_id:bigint, 商家ID),\n(stall_id:bigint, 档口ID),\n(customer_id:varchar, 客户ID),\n(customer_name:varchar, 客户名称),\n(arrears_amt:decimal, 当前欠款余额),\n(arrears_bill_cnt:bigint, 当前未结清欠款笔数),\n(earliest_arrears_date:date, 最早未结清欠款日期),\n(latest_arrears_date:date, 最近欠款发生日期),\n(arrears_days:int, 欠款账龄天数),\n(is_overdue:tinyint, 是否逾期),\n(overdue_amt:decimal, 逾期欠款金额),\n(created_at:datetime, 记录创建时间),\n(updated_at:datetime, 记录更新时间)\n]\n# Table: snap_product_inventory, 商品库存快照表\n[\n(snapshot_date:date, 库存快照日期),\n(seller_id:bigint, 商家ID),\n(stall_id:bigint, 档口ID),\n(product_id:varchar, 商品ID),\n(goods_no:varchar, 货号),\n(product_name:varchar, 商品名称),\n(stock_qty:bigint, 当前库存件数),\n(total_sales_qty:bigint, 历史总销量),\n(sales_qty_7d:bigint, 近7天销量),\n(sales_qty_30d:bigint, 近30天销量),\n(last_sale_time:datetime, 最后销售时间),\n(days_unsold:int, 未销售天数),\n(is_negative_stock:tinyint, 是否负库存),\n(is_dormant_30d:tinyint, 是否连续30天未动销),\n(created_at:datetime, 记录创建时间),\n(updated_at:datetime, 记录更新时间)\n]\n# Table: snap_unshipped_order, 未发订单快照表\n[\n(snapshot_date:date, 快照日期),\n(seller_id:bigint, 商家ID),\n(stall_id:bigint, 档口ID),\n(order_no:varchar, 未发订单号),\n(customer_id:varchar, 客户ID),\n(customer_name:varchar, 客户名称),\n(order_amount:decimal, 订单金额),\n(item_qty:bigint, 订单商品总件数),\n(shipped_qty:bigint, 已发件数),\n(unshipped_qty:bigint, 未发件数),\n(pend_ship_time:datetime, 进入待发货状态时间),\n(deadline_time:datetime, 应发截止时间),\n(overtime_days:int, 超时天数),\n(is_overtime:tinyint, 是否超时),\n(product_summary:text, 商品摘要，仅用于展示),\n(created_at:datetime, 记录创建时间),\n(updated_at:datetime, 记录更新时间)\n]\n\n\n### 当前问题:\n2026年6月30日店铺100011的总GMV是多少？\n\n### 以往提问:\n["2026年6月30日店铺100011的客户数是多少？","2026年6月30日店铺100011的客户数是多少？","2026年6月30日店铺100011的客户数是多少？","2026年6月30日店铺100011的客户数是多少？","2026年6月30日店铺100011的客户数是多少？","2026年6月30日店铺100011库存量最高的5个商品ID是什么？同时给出当前库存件数。","2026年6月30日店铺100011库存量最高的5个商品ID是什么？同时给出当前库存件数。","2026年6月30日店铺10