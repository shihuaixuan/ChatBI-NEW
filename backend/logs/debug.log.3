{"time": "2026-07-31 11:48:23,362", "name": "openai._base_client", "level": "DEBUG", "line": 1074, "message": "HTTP Response: POST https://api.deepseek.com/chat/completions \"200 OK\" Headers({'server': 'openresty', 'content-type': 'application/json', 'vary': 'origin, access-control-request-method, access-control-request-headers', 'access-control-allow-credentials': 'true', 'x-ds-trace-id': '28e604532c6d22bbc65f39bb81aa48a9', 'strict-transport-security': 'max-age=31536000; includeSubDomains; preload', 'x-content-type-options': 'nosniff', 'transfer-encoding': 'chunked', 'connection': 'keep-alive', 'date': 'Fri, 31 Jul 2026 03:48:17 GMT', 'eo-log-uuid': '17236800247315695201', 'eo-cache-status': 'MISS'})"}
