ne, 'description': '时间分桶（趋势），如 {\"asset_id\": 12, \"grain\": \"month\"}', 'title': 'Time Bucket'}, 'order_by': {'items': {'$ref': '#/$defs/CompileOrderBy'}, 'title': 'Order By', 'type': 'array'}, 'limit': {'anyOf': [{'type': 'integer'}, {'type': 'null'}], 'default': None, 'title': 'Limit'}}, 'title': 'CompileSemanticSqlArgs', 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'validate_sql', 'description': '校验 SQL：单语句、只读（SELECT/WITH）、无危险关键字、表在白名单内，并自动补 LIMIT。手写 SQL 在执行前必须先通过校验。', 'parameters': {'properties': {'sql': {'description': '待校验的 SQL', 'minLength': 1, 'title': 'Sql', 'type': 'string'}}, 'required': ['sql'], 'title': 'ValidateSqlArgs', 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'execute_sql', 'description': '执行只读 SQL 并返回样本行与统计摘要。内部强制：权限改写 → 只读校验 → 执行 → 截断。完整结果自动存档，不要试图获取全量数据。', 'parameters': {'properties': {'sql': {'description': '要执行的 SQL；优先使用 compile_semantic_sql 的产出', 'minLength': 1, 'title': 'Sql', 'type': 'string'}}, 'required': ['sql'], 'title': 'ExecuteSqlArgs', 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'finish', 'description': '结束本次问数并给出最终回答与图表建议。只有在 execute_sql 成功拿到真实数据后才允许调用；没有数据时应改为如实说明失败原因。', 'parameters': {'description': '结束作答。必须已存在成功的 execute_sql 结果。', 'properties': {'answer_markdown': {'description': '面向用户的最终回答（markdown）', 'minLength': 1, 'title': 'Answer Markdown', 'type': 'string'}, 'chart_type': {'anyOf': [{'enum': ['table', 'bar', 'line', 'pie'], 'type': 'string'}, {'type': 'null'}], 'default': None, 'description': '推荐图表类型', 'title': 'Chart Type'}, 'x_field': {'anyOf': [{'type': 'string'}, {'type': 'null'}], 'default': None, 'description': 'x 轴/类别字段名', 'title': 'X Field'}, 'y_fields': {'description': '数值系列字段名', 'items': {'type': 'string'}, 'title': 'Y Fields', 'type': 'array'}}, 'required': ['answer_markdown'], 'title': 'FinishArgs', 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'clarify', 'description': '当歧义会影响 SQL 正确性时（指标口径二义、时间范围缺失、维度不明确），向用户澄清。必须给出结构化选项（来自语义包候选）。不要为可以