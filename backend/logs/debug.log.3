t":true,"missing_slots":["context"],"confidence":0.3}', 'role': 'system'}, {'content': '{"question":"2026年6月店铺100011的销售额是多少？","datasource_id":13,"conversation_context":{"last_rewritten_question":"2026年6月店铺100011的销售额是多少？"}}', 'role': 'user'}], 'model': 'deepseek-v4-flash', 'stream': False, 'temperature': 0}}
