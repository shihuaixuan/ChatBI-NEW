e': 'null'}], 'default': None, 'description': '选项对应的语义资产 id（如指标候选）', 'title': 'Asset Id'}}, 'required': ['label', 'value'], 'title': 'ClarifyOption', 'type': 'object'}}, 'description': '向用户澄清关键歧义。这是终止动作：本轮暂停，等待用户回答后继续。', 'properties': {'question': {'description': '向用户提出的澄清问题', 'minLength': 1, 'title': 'Question', 'type': 'string'}, 'options': {'description': '结构化选项（强烈建议提供，来自语义包候选）；为空表示自由文本澄清', 'items': {'$ref': '#/$defs/ClarifyOption'}, 'title': 'Options', 'type': 'array'}}, 'required': ['question'], 'title': 'ClarifyArgs', 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'search_terminology', 'description': '查询业务术语的解释与映射（同义词、口径说明）。用于理解问题中的黑话/缩写。', 'parameters': {'properties': {'term': {'description': '要查询的业务术语或口语说法', 'minLength': 1, 'title': 'Term', 'type': 'string'}}, 'required': ['term'], 'title': 'SearchTerminologyArgs', 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'get_sql_examples', 'description': '召回与问题相似的历史问答 SQL 示例（few-shot 参考）。注意：示例仅供写 SQL 参考，不是真实查询结果，禁止当作答案。', 'parameters': {'properties': {'question': {'description': '用于召回相似示例的问题文本', 'minLength': 1, 'title': 'Question', 'type': 'string'}}, 'required': ['question'], 'title': 'GetSqlExamplesArgs', 'type': 'object'}}}]}}"}
