mputeTask\": {\"additionalProperties\": false, \"properties\": {\"derive\": {\"default\": [], \"items\": {\"$ref\": \"#/$defs/ComputeDerivation\"}, \"title\": \"Derive\", \"type\": \"array\"}, \"id\": {\"maxLength\": 128, \"minLength\": 1, \"title\": \"Id\", \"type\": \"string\"}, \"inputs\": {\"items\": {\"type\": \"string\"}, \"minItems\": 1, \"title\": \"Inputs\", \"type\": \"array\"}, \"join_on\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Join On\", \"type\": \"array\"}, \"operation\": {\"$ref\": \"#/$defs/ComputeOperation\"}, \"options\": {\"additionalProperties\": true, \"title\": \"Options\", \"type\": \"object\"}, \"type\": {\"const\": \"compute\", \"default\": \"compute\", \"title\": \"Type\", \"type\": \"string\"}}, \"required\": [\"id\", \"operation\", \"inputs\"], \"title\": \"ComputeTask\", \"type\": \"object\"}, \"PlanEdge\": {\"additionalProperties\": false, \"properties\": {\"source\": {\"maxLength\": 128, \"minLength\": 1, \"title\": \"Source\", \"type\": \"string\"}, \"target\": {\"maxLength\": 128, \"minLength\": 1, \"title\": \"Target\", \"type\": \"string\"}}, \"required\": [\"source\", \"target\"], \"title\": \"PlanEdge\", \"type\": \"object\"}, \"PlanValidation\": {\"additionalProperties\": false, \"properties\": {\"reason_codes\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Reason Codes\", \"type\": \"array\"}, \"reports\": {\"default\": [], \"items\": {\"additionalProperties\": true, \"type\": \"object\"}, \"title\": \"Reports\", \"type\": \"array\"}, \"status\": {\"$ref\": \"#/$defs/AnalysisPlanStatus\", \"default\": \"DRAFT\"}}, \"title\": \"PlanValidation\", \"type\": \"object\"}, \"PresentationHint\": {\"additionalProperties\": false, \"properties\": {\"chart_hint\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Chart Hint\"}, \"primary_result\": {\"maxLength\": 128, \"minLength\": 1, \"title\": \"Primary Result\", \"type\": \"string\"}}, \"requir