{"time": "2026-08-17 11:52:56,681", "name": "openai._base_client", "level": "DEBUG", "line": 1074, "message": "HTTP Response: POST https://api.deepseek.com/chat/completions \"200 OK\" Headers({'server': 'openresty', 'content-type': 'application/json', 'vary': 'origin, access-control-request-method, access-control-request-headers', 'access-control-allow-credentials': 'true', 'x-ds-trace-id': '0f55d39cbba3daf85a192936cad2ef6f', 'strict-transport-security': 'max-age=31536000; includeSubDomains; preload', 'x-content-type-options': 'nosniff', 'transfer-encoding': 'chunked', 'connection': 'keep-alive', 'date': 'Mon, 17 Aug 2026 03:52:54 GMT', 'eo-log-uuid': '10766614192094656304', 'eo-cache-status': 'MISS'})"}
