{"time": "2026-08-17 14:38:58,035", "name": "openai._base_client", "level": "DEBUG", "line": 1074, "message": "HTTP Response: POST https://api.deepseek.com/chat/completions \"200 OK\" Headers({'server': 'openresty', 'content-type': 'application/json', 'vary': 'origin, access-control-request-method, access-control-request-headers', 'access-control-allow-credentials': 'true', 'x-ds-trace-id': '9924203fe4073891ac377a51bfcdc245', 'strict-transport-security': 'max-age=31536000; includeSubDomains; preload', 'x-content-type-options': 'nosniff', 'transfer-encoding': 'chunked', 'connection': 'keep-alive', 'date': 'Mon, 17 Aug 2026 06:38:56 GMT', 'eo-log-uuid': '10158057678893817081', 'eo-cache-status': 'MISS'})"}
