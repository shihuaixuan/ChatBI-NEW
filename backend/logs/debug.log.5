memory_type\":\"query_shape_preference\",\"statement\":\"用户进行排名分析时倾向查看前1项\",\"confidence\":0.55,\"evidence_count\":5}],\"conflicts\":[]}},\"temporal_config\":{\"reference_at\":\"2026-08-17T21:30:51.838756+08:00\",\"timezone\":\"Asia/Shanghai\",\"locale\":\"zh-CN\",\"week_start\":\"monday\",\"fiscal_year_start_month\":1,\"fiscal_year_label\":\"start_year\",\"business_calendar_id\":null},\"user_feedback\":{},\"user_confirmation\":null}', 'role': 'user'}], 'model': 'deepseek-v4-flash', 'reasoning_effort': 'low', 'stream': False, 'temperature': 0}}"}
