"data_type\":\"datetime\",\"semantic_type\":\"time\",\"value_kind\":\"date\",\"is_time\":true},{\"name\":\"应发截止时间\",\"aliases\":[],\"data_type\":\"datetime\",\"semantic_type\":\"time\",\"value_kind\":\"date\",\"is_time\":true},{\"name\":\"库存快照日期\",\"aliases\":[],\"data_type\":\"date\",\"semantic_type\":\"time\",\"value_kind\":\"date\",\"is_time\":true},{\"name\":\"最后销售时间\",\"aliases\":[],\"data_type\":\"datetime\",\"semantic_type\":\"time\",\"value_kind\":\"date\",\"is_time\":true},{\"name\":\"交易统计日期\",\"aliases\":[],\"data_type\":\"date\",\"semantic_type\":\"time\",\"value_kind\":\"date\",\"is_time\":true},{\"name\":\"最近下单时间\",\"aliases\":[],\"data_type\":\"datetime\",\"semantic_type\":\"time\",\"value_kind\":\"date\",\"is_time\":true},{\"name\":\"欠款快照日期\",\"aliases\":[],\"data_type\":\"date\",\"semantic_type\":\"time\",\"value_kind\":\"date\",\"is_time\":true},{\"name\":\"最早未结清欠款日期\",\"aliases\":[],\"data_type\":\"date\",\"semantic_type\":\"time\",\"value_kind\":\"date\",\"is_time\":true},{\"name\":\"最近欠款发生日期\",\"aliases\":[],\"data_type\":\"date\",\"semantic_type\":\"time\",\"value_kind\":\"date\",\"is_time\":true}],\"dataset_instructions\":{\"question_categorization\":[\"优先识别指标、维度、时间范围、比较和多查询形态；语义契约未验证或存在歧义时不得猜测，应澄清或拒答。跨模型请求必须保留独立子查询。\"]}}', 'role': 'user'}], 'model': 'deepseek-v4-flash', 'reasoning_effort': 'low', 'stream': False, 'temperature': 0}}"}
