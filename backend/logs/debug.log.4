t":true,"missing_slots":["context"],"confidence":0.3}', 'role': 'system'}, {'content': '{"question":"2026年6月30日对比店铺100011和店铺100012的总GMV，哪个更高？","datasource_id":13,"conversation_context":{"last_rewritten_question":null}}', 'role': 'user'}], 'model': 'deepseek-v4-flash', 'stream': False, 'temperature': 0}}
