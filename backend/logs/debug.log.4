t":true,"missing_slots":["context"],"confidence":0.3}', 'role': 'system'}, {'content': '{"question":"2026年6月30日店铺100011和店铺100012分别有多少总下单客户数？","datasource_id":13,"conversation_context":{"last_rewritten_question":"2026年6月30日店铺100011和店铺100012分别有多少总下单客户数？"}}', 'role': 'user'}], 'model': 'deepseek-v4-flash', 'reasoning_effort': 'low', 'stream': False, 'temperature': 0}}
