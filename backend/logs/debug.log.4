t":true,"missing_slots":["context"],"confidence":0.3}', 'role': 'system'}, {'content': '{"question":"2026年6月30日店铺100011的销售类GMV占总GMV比例是多少？","datasource_id":13,"conversation_context":{"last_rewritten_question":null,"user_memory":{"profile":[],"scenarios":[{"memory_id":3,"layer":"scenario","memory_type":"query_shape_preference","statement":"用户进行趋势分析时倾向按day查看。","confidence":0.55,"evidence_count":3}],"hints":[],"conflicts":[]}}}', 'role': 'user'}], 'model': 'deepseek-v4-flash', 'reasoning_effort': 'low', 'stream': False, 'temperature': 0}}
