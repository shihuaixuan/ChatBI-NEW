t":true,"missing_slots":["context"],"confidence":0.3}', 'role': 'system'}, {'content': '{"question":"2026年6月30日店铺100011商品ID为P1000101001的当前库存件数、近7天销量和近30天销量是多少？","datasource_id":13,"conversation_context":{"last_rewritten_question":null,"user_memory":{"profile":[],"scenarios":[],"hints":[],"conflicts":[]}}}', 'role': 'user'}], 'model': 'deepseek-v4-flash', 'reasoning_effort': 'low', 'stream': False, 'temperature': 0}}
