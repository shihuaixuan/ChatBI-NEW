t":true,"missing_slots":["context"],"confidence":0.3}', 'role': 'system'}, {'content': '{"question":"2026年6月30日店铺100011的未发订单号USO202606300001的订单金额、未发件数和是否超时是多少？","datasource_id":13,"conversation_context":{"last_rewritten_question":null,"user_memory":{"profile":[],"scenarios":[],"hints":[],"conflicts":[]}}}', 'role': 'user'}], 'model': 'deepseek-v4-flash', 'reasoning_effort': 'low', 'stream': False, 'temperature': 0}}
